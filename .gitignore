# rust
/target/

# editor
*~
.*~
*.swp
*.swo
\#*#
.vscode/

# python
*.pyc
*.pyo
__pycache__/
__main__/

# ninja
.ninja_deps
.ninja_log

# colcon
/build/
/install/
/log/
/build_logs/
# ROS 2 launch/run logs written under ros/ when a node is started from there
/ros/log/

# Cargo and Rust workspace artifacts
/.cargo/
# Per-package cargo configs written by colcon-cargo-ros2. They pin [patch.crates-io]
# at paths inside build/, so they are generated per build tree, never authored.
ros/*/.cargo/
/ros2_rust_ws/build/
/ros2_rust_ws/install/
/ros2_rust_ws/log/

# Environment files
.env
.env.local

# OS files
.DS_Store
Thumbs.db

# Backup files
*.bak
*.orig

# ROS specific
*.bag
*.db3
.ros/

# Test artifacts
/test_results/
/coverage/
*.gcda
*.gcno
*.gcov

# IDE specific
.idea/
*.sublime-workspace
*.sublime-project

# Python environments
venv/
.venv/
env/
.env/

# Setup markers
setup/.markers/

# Recorded ROS 2 bags used as boarddet benchmark data (TWO_LIDAR_*).
# ~2.4 GB of .db3 plus ~1.9 GB of redundant .zip archives -- far too large to
# put in git history, and re-derivable only by re-recording. See
# ros/lctk_sample_data/bags/README.md for the expected layout.
/ros/lctk_sample_data/bags/

# Per-session run outputs: detections archives, exports, logs.
/sessions/*/out/

# A session's own copy of, or symlink to, its recording. The bag itself is
# already ignored above; this keeps the link out of git too, so cloning the
# repo never implies the recording is present.
/sessions/*/bag

# Play log
/play_log

# Generated local launch records and scratch plans
/record.json
/tmp/
