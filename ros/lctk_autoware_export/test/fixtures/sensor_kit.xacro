<?xml version="1.0"?>
<!-- Minimal replica of Autoware's sensor_kit.xacro mechanism: load the calibration
     YAML with xacro.load_yaml and emit one fixed joint per entry. Used by the e2e
     test to prove the exported YAML round-trips through the real xacro pipeline. -->
<robot name="e2e_kit" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="config_dir" default=""/>
  <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>
  <xacro:property name="entry" value="${calibration['sensor_kit_base_link']['camera0/camera_link']}"/>

  <link name="sensor_kit_base_link"/>
  <link name="camera0/camera_link"/>
  <joint name="camera0/camera_link_joint" type="fixed">
    <origin
      xyz="${entry['x']} ${entry['y']} ${entry['z']}"
      rpy="${entry['roll']} ${entry['pitch']} ${entry['yaw']}"/>
    <parent link="sensor_kit_base_link"/>
    <child link="camera0/camera_link"/>
  </joint>
</robot>
