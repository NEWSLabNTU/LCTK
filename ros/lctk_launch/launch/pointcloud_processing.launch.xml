<?xml version="1.0"?>
<!--
    Launch file for point cloud processing pipeline (calibration board detection).

    This launch file starts the calibration board locator node that detects
    calibration boards in point cloud data and publishes their locations.

    Input topics:
    - Point cloud topic

    Output topics:
    - Board detections
-->
<launch>
    <!-- Launch Arguments -->
    <arg name="board_config_file"
         default=""
         description="Path to calibration board configuration JSON5 file"/>

    <arg name="aruco_config_file"
         default=""
         description="Path to ArUco pattern configuration JSON5 file"/>

    <arg name="pointcloud_topic"
         default="/sensing/lidar/top/pointcloud_raw"
         description="Input point cloud topic"/>

    <arg name="board_detections_topic"
         default="/calibration/calibration_board_detections"
         description="Output board detections topic"/>

    <arg name="namespace"
         default="calibration"
         description="Namespace for the nodes"/>

    <arg name="debug_mode"
         default="false"
         description="Enable debug logging and debug point cloud publishing to debug/all_points, debug/filtered_points, debug/plane_inliers"/>

    <arg name="enable_icp_iteration_debug"
         default="$(var debug_mode)"
         description="Enable ICP iteration debug publishing to debug/icp/iteration_pose, debug/icp/iteration_stats topics. Defaults to same value as debug_mode."/>

    <arg name="log_level"
         default="info"
         description="ROS log level (debug, info, warn, error, fatal)"/>

    <arg name="use_best_effort_qos"
         default="true"
         description="Use best effort QoS for sensor input topics"/>

    <!-- LiDAR Board Detector Node -->
    <node pkg="lidar_board_detector"
          exec="lidar_board_detector"
          name="lidar_board_detector"
          namespace="$(var namespace)/lidar_board_detector"
          output="screen"
          args="--ros-args --log-level $(var log_level)">
        <param name="board_detector_file" value="$(find-pkg-share lctk_launch)/config/board/board_detector.json5"/>
        <param name="aruco_pattern_file" value="$(var aruco_config_file)"/>
        <param name="bbox_file" value="$(find-pkg-share lctk_launch)/config/board/bbox.json5"/>
        <param name="enable_debug" value="$(var debug_mode)"/>
        <param name="enable_icp_iteration_debug" value="$(var enable_icp_iteration_debug)"/>
        <param name="use_best_effort_qos" value="$(var use_best_effort_qos)"/>
        <remap from="input_pointcloud" to="$(var pointcloud_topic)"/>
    </node>
</launch>