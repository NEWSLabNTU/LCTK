<?xml version="1.0"?>
<!--
    RViz visualization for the calibration graph.

    Started by calibrate.launch.py when enable_rviz is true. The layout comes
    from rviz_config, which session.launch.py points at a session's own
    rviz.rviz when it ships one.

    Usage:
    ros2 launch lctk_launch rviz.launch.xml
-->
<launch>
    <arg name="rviz_config"
         default="$(find-pkg-share lctk_launch)/config/rviz/calibration.rviz"
         description="Path to RViz configuration file"/>

    <!--
        One node, and deliberately no respawn.

        This file used to declare the node twice: once namespaced under
        `if="$(var use_namespace)"`, once bare under the matching `unless`, for
        a `use_namespace` argument that no caller ever passed. Two declarations
        sharing the name `rviz2` is a second window waiting to happen, and the
        branch that would have justified it was unreachable, so both are gone.

        The `respawn` flag is gone too. RViz is an operator's viewer, not a
        pipeline stage: closing the window is a deliberate act, and respawning
        it turns that into a window which will not stay shut. Nothing
        downstream consumes RViz, so its exit is not a failure the graph needs
        to recover from.
    -->
    <node pkg="rviz2"
          exec="rviz2"
          name="rviz2"
          output="screen"
          args="-d $(var rviz_config)"/>
</launch>
