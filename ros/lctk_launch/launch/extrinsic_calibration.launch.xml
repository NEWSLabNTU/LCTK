<?xml version="1.0"?>
<!--
    Launch file for extrinsic calibration computation.

    This launch file starts the extrinsic solver node that directly consumes
    detections from image and point cloud processing pipelines to compute
    the extrinsic calibration between sensors without timestamp synchronization.

    Input topics:
    - ArUco detections from image processing
    - Board detections from point cloud processing
    - Camera info

    Output topics:
    - Extrinsic transform
-->
<launch>
    <!-- Launch Arguments -->
    <arg name="aruco_config_file"
         default="$(find-pkg-share lctk_launch)/config/aruco/aruco_pattern.json5"
         description="Path to ArUco pattern configuration JSON5 file"/>

    <arg name="aruco_detections_topic"
         default="/calibration/aruco_locator/aruco_detections"
         description="Input ArUco detections topic"/>

    <arg name="board_detections_topic"
         default="/calibration/lidar_board_detector/board_detections"
         description="Input board detections topic"/>

    <arg name="use_synchronized_input"
         default="false"
         description="Use conflux to synchronize ArUco and board detections by timestamp"/>


    <arg name="namespace"
         default="calibration"
         description="Namespace for the nodes"/>

    <arg name="solver_method"
         default="SQPNP"
         description="Solver method for extrinsic calibration"/>

    <arg name="min_detections_required"
         default="1"
         description="Minimum number of detections required for calibration"/>

    <arg name="debug_mode"
         default="true"
         description="Enable debug logging and visualization"/>

    <arg name="log_level"
         default="info"
         description="ROS log level (debug, info, warn, error, fatal)"/>

    <arg name="camera_topic"
         default="/sensing/camera/front_center/image_raw"
         description="Camera image topic (used to derive camera_info topic)"/>

    <arg name="use_advanced_solver"
         default="false"
         description="Use advanced extrinsic solver (buffered multi-pose) instead of educational solver"/>

    <!-- Detection Synchronizer (conflux) - only when use_synchronized_input is true -->
    <node pkg="conflux-node"
          exec="conflux-node"
          name="detection_sync"
          namespace="$(var namespace)"
          output="screen"
          if="$(var use_synchronized_input)">
        <param name="config_file"
               value="$(find-pkg-share lctk_launch)/config/detection_sync.yaml"/>
    </node>

    <!-- =================================================================== -->
    <!-- Educational Extrinsic Solver Node (without synchronization)        -->
    <!-- =================================================================== -->
    <group unless="$(var use_advanced_solver)">
        <!-- Without sync: subscribe to raw detection topics -->
        <node pkg="extrinsic_solver_node"
              exec="extrinsic_solver_node"
              name="extrinsic_solver_node"
              namespace="$(var namespace)/extrinsic_solver"
              output="screen"
              args="--ros-args --log-level $(var log_level)"
              unless="$(var use_synchronized_input)">
            <param name="aruco_config_file" value="$(var aruco_config_file)"/>
            <param name="solver_method" value="$(var solver_method)"/>
            <param name="min_detections_required" value="$(var min_detections_required)"/>
            <param name="max_solver_iterations" value="1000"/>
            <param name="convergence_threshold" value="1e-6"/>
            <param name="debug_mode" value="$(var debug_mode)"/>
            <param name="camera_topic" value="$(var camera_topic)"/>
            <remap from="aruco_detections" to="$(var aruco_detections_topic)"/>
            <remap from="calibration_board_detections" to="$(var board_detections_topic)"/>
        </node>

        <!-- With sync: subscribe to synchronized detection topics -->
        <node pkg="extrinsic_solver_node"
              exec="extrinsic_solver_node"
              name="extrinsic_solver_node"
              namespace="$(var namespace)/extrinsic_solver"
              output="screen"
              args="--ros-args --log-level $(var log_level)"
              if="$(var use_synchronized_input)">
            <param name="aruco_config_file" value="$(var aruco_config_file)"/>
            <param name="solver_method" value="$(var solver_method)"/>
            <param name="min_detections_required" value="$(var min_detections_required)"/>
            <param name="max_solver_iterations" value="1000"/>
            <param name="convergence_threshold" value="1e-6"/>
            <param name="debug_mode" value="$(var debug_mode)"/>
            <param name="camera_topic" value="$(var camera_topic)"/>
            <remap from="aruco_detections" to="$(var aruco_detections_topic)_sync"/>
            <remap from="calibration_board_detections" to="$(var board_detections_topic)_sync"/>
        </node>
    </group>

    <!-- =================================================================== -->
    <!-- Advanced Extrinsic Solver Node (service-driven multi-pose)         -->
    <!-- =================================================================== -->
    <group if="$(var use_advanced_solver)">
        <!-- Without sync: subscribe to raw detection topics -->
        <node pkg="advanced_extrinsic_solver"
              exec="advanced_extrinsic_solver"
              name="advanced_extrinsic_solver"
              namespace="$(var namespace)/advanced_extrinsic_solver"
              output="screen"
              args="--ros-args --log-level $(var log_level)"
              unless="$(var use_synchronized_input)">
            <param name="aruco_config_file" value="$(var aruco_config_file)"/>
            <param name="debug_mode" value="$(var debug_mode)"/>
            <param name="camera_topic" value="$(var camera_topic)"/>
            <param name="parent_frame" value="lidar"/>
            <param name="child_frame" value="camera"/>
            <param name="publishing_rate" value="10.0"/>
            <remap from="aruco_detections" to="$(var aruco_detections_topic)"/>
            <remap from="calibration_board_detections" to="$(var board_detections_topic)"/>
            <remap from="extrinsic_transform" to="/$(var namespace)/extrinsic_solver/extrinsic_transform"/>
        </node>

        <!-- With sync: subscribe to synchronized detection topics -->
        <node pkg="advanced_extrinsic_solver"
              exec="advanced_extrinsic_solver"
              name="advanced_extrinsic_solver"
              namespace="$(var namespace)/advanced_extrinsic_solver"
              output="screen"
              args="--ros-args --log-level $(var log_level)"
              if="$(var use_synchronized_input)">
            <param name="aruco_config_file" value="$(var aruco_config_file)"/>
            <param name="debug_mode" value="$(var debug_mode)"/>
            <param name="camera_topic" value="$(var camera_topic)"/>
            <param name="parent_frame" value="lidar"/>
            <param name="child_frame" value="camera"/>
            <param name="publishing_rate" value="10.0"/>
            <remap from="aruco_detections" to="$(var aruco_detections_topic)_sync"/>
            <remap from="calibration_board_detections" to="$(var board_detections_topic)_sync"/>
            <remap from="extrinsic_transform" to="/$(var namespace)/extrinsic_solver/extrinsic_transform"/>
        </node>
    </group>
</launch>