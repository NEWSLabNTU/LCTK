<?xml version="1.0"?>
<!--
    Demo launch file that runs both sample data playback and LiDAR-camera calibration.

    This combines:
    - Sample sensor data playback (LiDAR + camera)
    - Full calibration pipeline (ArUco detection, board detection, extrinsic solver)

    Usage:
    ros2 launch lctk_launch lidar_camera_demo.launch.xml
    ros2 launch lctk_launch lidar_camera_demo.launch.xml debug_mode:=true enable_rviz:=true
-->
<launch>
    <!-- Sample Data Arguments -->
    <arg name="pcap_file"
         default="$(find-pkg-share lctk_sample_data)/data/3/lidar.pcap"
         description="Path to the PCAP file containing Velodyne VLP-32C data"/>

    <arg name="video_file"
         default="$(find-pkg-share lctk_sample_data)/data/3/video.avi"
         description="Path to the video file (mp4, avi, etc.)"/>

    <!-- Calibration Arguments -->
    <arg name="debug_mode"
         default="false"
         description="Enable debug logging and visualization"/>

    <arg name="enable_icp_iteration_debug"
         default="$(var debug_mode)"
         description="Enable ICP iteration-level debugging"/>

    <arg name="enable_rviz"
         default="false"
         description="Launch RViz for calibration visualization"/>

    <arg name="enable_judge"
         default="true"
         description="Enable calibration quality judge"/>

    <arg name="enable_overlay"
         default="true"
         description="Enable ArUco detection overlay visualization"/>

    <arg name="log_level"
         default="info"
         description="ROS log level (debug, info, warn, error, fatal)"/>

    <arg name="use_best_effort_qos"
         default="true"
         description="Use best effort QoS for sensor input topics"/>

    <arg name="use_advanced_solver"
         default="false"
         description="Use advanced extrinsic solver instead of educational solver"/>

    <!-- Topic names (shared between sample data and calibration) -->
    <arg name="camera_topic"
         default="/sensing/camera/front_center/image_raw"
         description="Camera image topic"/>

    <arg name="pointcloud_topic"
         default="/sensing/lidar/top/pointcloud_raw"
         description="Point cloud topic"/>

    <!-- Sample Data Playback -->
    <include file="$(find-pkg-share lctk_sample_data)/launch/lidar_camera.launch.xml">
        <arg name="pcap_file" value="$(var pcap_file)"/>
        <arg name="video_file" value="$(var video_file)"/>
        <arg name="pointcloud_topic" value="$(var pointcloud_topic)"/>
        <arg name="camera_namespace" value="/sensing/camera/front_center"/>
    </include>

    <!-- Calibration Pipeline -->
    <include file="$(find-pkg-share lctk_launch)/launch/lidar_camera_calibration.launch.xml">
        <arg name="camera_topic" value="$(var camera_topic)"/>
        <arg name="pointcloud_topic" value="$(var pointcloud_topic)"/>
        <arg name="debug_mode" value="$(var debug_mode)"/>
        <arg name="enable_icp_iteration_debug" value="$(var enable_icp_iteration_debug)"/>
        <arg name="enable_rviz" value="$(var enable_rviz)"/>
        <arg name="enable_judge" value="$(var enable_judge)"/>
        <arg name="enable_overlay" value="$(var enable_overlay)"/>
        <arg name="log_level" value="$(var log_level)"/>
        <arg name="use_best_effort_qos" value="$(var use_best_effort_qos)"/>
        <arg name="use_advanced_solver" value="$(var use_advanced_solver)"/>
    </include>
</launch>
