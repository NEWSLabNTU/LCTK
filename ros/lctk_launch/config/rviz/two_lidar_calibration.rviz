Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LiDAR 1 (top_lidar)1/Input points1/Topic1
        - /LiDAR 1 (top_lidar)1/RANSAC1
        - /LiDAR 1 (top_lidar)1/RANSAC1/Inlier points1/Topic1
        - /LiDAR 1 (top_lidar)1/ICP1
        - /LiDAR 1 (top_lidar)1/ICP1/Initial board1/Topic1
        - /LiDAR 1 (top_lidar)1/ICP1/Final board1/Topic1
        - /LiDAR 2 (front_lidar)1/RANSAC1
        - /LiDAR 2 (front_lidar)1/RANSAC1/Inlier points1/Topic1
        - /LiDAR 2 (front_lidar)1/ICP1/Final board1/Topic1
        - /LiDAR 2 (front_lidar)1/best rejected cluster1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 656
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Input points
Visualization Manager:
  Class: ""
