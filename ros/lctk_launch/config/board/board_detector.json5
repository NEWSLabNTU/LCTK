{
    // ========================================
    // RANSAC Plane Fitting Parameters
    // ========================================
    // max number of RANSAC steps
    "plane_ransac_max_iterations": 2000,
    // the loss threshold that a point is considered an inlier (5cm - reasonable for calibration)
    "plane_ransac_inlier_threshold": 0.05,
    // skip RANSAC and use all bbox-filtered points directly for ICP (for testing/debugging)
    "skip_ransac": true,

    // ========================================
    // ICP Algorithm Parameters
    // ========================================
    // max number of ICP iterations (increased for observing convergence behavior)
    "max_icp_iterations": 50,
    // pose weight is amount of pose change per iteration
    // the ICP terminates if pose weight is below this threshold several times
    "icp_pose_weight_threshold": 1e-4,
    // the maximum accepted ICP loss (balanced for stability)
    "icp_rejection_threshold": 0.008,
    // Maximum mean point-to-model distance, in metres, for a board fit to be ACCEPTED.
    //
    // This must sit ABOVE the sensor's own range noise, or no fit can ever pass. A VLP-32C is
    // spec'd at roughly +/-3 cm range accuracy, and the measured ICP loss on the sample data
    // asymptotes at 0.026-0.029 (the same range CLAUDE.md's profiling section records as normal).
    // So ~0.026 is the noise floor, not a bad fit.
    //
    // It was 0.012 between commit 19a82f3 and 2026-07-13, i.e. below that floor -- so the gate
    // could never pass and the detector published empty detections forever (see docs/issues/C-04).
    // 0.035 clears the observed maximum (0.0286) with margin while still rejecting gross misfits.
    "icp_good_fit_threshold": 0.035,
    // outlier rejection threshold for correspondence filtering - DISABLED (set to infinity to keep all points)
    "icp_outlier_threshold": 0.050,  // Effectively disabled - keep all correspondences
    // damping factor for pose updates (increased for better convergence)
    "icp_damping_factor": 0.5,  // Increased from 0.35 to 0.6
    // minimum number of inlier points required to continue ICP iterations - LOWERED to avoid early termination
    "icp_min_inlier_points": 500,  // Lowered from 1500 to avoid stopping when points are good

    // ========================================
    // Voxel Downsampling (Performance Optimization)
    // ========================================
    // Reduces point cloud density while preserving geometry
    // Recommended for large point clouds (>10K points) to improve ICP speed
    "voxel_downsample_enabled": true,       // Default: disabled (preserve current behavior)
    "voxel_downsample_size": 0.015,           // 3cm voxels for aggressive downsampling
                                              // 0.015m: conservative (60-70% reduction)
                                              // 0.02m: balanced (70-80% reduction)
                                              // 0.03m: aggressive (85-90% reduction)
    "voxel_downsample_use_centroid": false,  // Use first point in voxel (preserves plane geometry)
                                              // true: better edge preservation, but moves points off plane
                                              // false: faster, preserves RANSAC plane inlier positions
    "voxel_parallel_threshold": 50000,       // Use parallel for >50K points (requires 'parallel' feature)

    // ========================================
    // Board Geometry Parameters
    // ========================================
    // the length of border margin
    "board_width": "1000mm",    // mm
    // the radius of circle holes
    "hole_radius": "150mm",     // mm
    // suppose the center of board is (0, 0)
    // the center of hole will be at (+/- shift, +/- shift)
    "hole_center_shift": "200mm", // mm

    // ========================================
    // Sensor Coordinate Convention (legacy ICP pose stage)
    // ========================================
    // Axis pointing "up" in the sensor frame: "x", "y", or "z" (default: "z").
    // Drives the board's initial in-plane pose AND the post-fixup lowest-corner pick.
    // Seyond LiDAR: X=up, Z=forward → "x". Velodyne/standard ROS: Z=up → "z".
    "sensor_up_axis": "x",
    // Extra in-plane rotation applied to the initial board pose (degrees, default: 0).
    // Corrects a fixed rotational offset visible in RViz. Positive = CCW from sensor.
    // Try 45, -45, 90, -90 if the board frame is rotated off the surface.
    "initial_inplane_rotation_deg": 45.0,

    // ========================================
    // Crop-box-free detection (board-projection-detector)
    // ========================================
    // "bbox" (default, existing bounding-box crop) | "bbox_free"
    // Testing bbox_free (Method-E) against the 2026golf seyond+camera rosbags.
    "detection_mode": "bbox_free",
    // Read only when detection_mode == "bbox_free".
    "bbox_free": {
        // "background_subtraction" (Method E, ~34-69ms, shipping) |
        // "plane_strip" (Method B, ~157-202ms, over budget)
        "foreground_method": "background_subtraction",
        // Voxel edge (m) for the detector's internal downsample (the detect() `voxel` arg).
        "voxel": 0.05,
        // Deserialized into board-projection-detector's BoardConfig. These MUST be the
        // production operating point spelled out explicitly: BoardConfig's serde defaults
        // are the frozen library defaults (flatness 0.035, stance_floor 0.0, isolation false),
        // NOT these.
        // Units are stated so tuning is data-driven: the node logs on each reject
        // "measured=X vs threshold=Y [unit]; candidates=N" — compare against these.
        "board": {
            "side_m": 1.0,                    // board edge length, metres
            // Seyond LiDAR: X=up, Z=forward. (VLP/sample-data used [0,0,1].)
            "up_axis": [1.0, 0.0, 0.0],
            "cluster_min_points": 20,         // min points for a DBSCAN cluster to survive (count)
            "side_tol": 0.20,                 // allowed |cluster extent − side_m|, metres
            "cell_m": 0.02,                   // occupancy grid cell edge, metres
            "vertical_gap_deg": 3.0,          // plane-strip vertical band half-width, degrees
            "flatness_rms_max": 0.045,        // max plane-fit RMS, metres (reject: Flatness)
            "stance_floor": 0.9,              // min normalized diagonal·up 0-1 (~0.71 flat, ~1.0 corner); reject: Stance when <=
            "square_icp_residual_max": 0.45,  // max square coverage residual, unitless; reject: SquareResidual when >=
            "isolation": true,
            "isolation_max_density": 0.3      // max exterior-band density, points per metre of perimeter; reject: Isolation when >
        },
        // Method-E background model + warmup. min_sources is fixed at 1 (single live session).
        "background": {
            "dilation_radius": 1,
            "warmup_frames": 20
        }
    }
}
