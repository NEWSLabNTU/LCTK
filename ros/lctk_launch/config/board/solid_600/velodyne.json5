// EXPERIMENTAL — Solid 600 mm target — Velodyne VLP-32C detector tuning.
//
// This is a sensor-specific starting preset, not a field-validated operating
// point. Keep it experimental until a real-bag evidence report is accepted.
// Target geometry is selected only by target_config (solid_600_aruco_1_v1.json5).
{
  "detection_mode": "bbox_free",
  "foreground_method": "background_subtraction",
  "bbf_voxel": 0.05,
  "bg_dilation_radius": 1,
  "bg_warmup_frames": 20,
  "strip_plane_dist": 0.05,
  "strip_plane_min_frac": 0.08,
  "cluster_eps": 0.15,
  "cluster_min_points": 10,
  "vertical_gap_deg": 0.5,
  "merge_seed_min_points": 40,
  "merge_offset_tol": 0.02,
  "merge_dist_factor": 1.6,
  // H-17: 40, not the 60 inherited from the 1000 mm perforated plate. A 600 mm solid
  // plate at 7-8 m returns 35-420 points depending on how many rings cross it, measured
  // over real frames; 60 cuts genuine boards at the sparse end. Per-frame diagnostic on
  // 12 real frames: 4 of 12 were rejected here with clusters of 35-51 points, all of
  // them the plate. Discrimination stays with flatness and the extent gates.
  //
  // flatness_rms_max is deliberately NOT relaxed alongside it. Three further frames fail
  // it at 0.0466-0.0607, but clean board-only clusters measure 0.012-0.030, so those
  // clusters are carrying the holder and raising the gate would admit clutter.
  "patch_min_points": 40,
  "flatness_rms_max": 0.045,
  "patch_extent_lo_frac": 0.5,
  "patch_extent_hi_diag_frac": 1.8,
  "side_tol": 0.20,
  "cell_m": 0.02,
  "square_icp_residual_max": 0.45,
  // H-17: gate on the square fit's GEOMETRIC residual, not the combined one.
  //
  // The combined residual adds a perimeter-coverage term that a 600 mm plate at 7-8 m
  // cannot satisfy: the VLP-32C's rings are ~15 cm apart, so ~half the perimeter bins
  // never hold a point and the best residual any real frame produced was 0.4513 against
  // a 0.45 gate -- 127 frames, zero accepted. Coverage still selects theta; it just no
  // longer decides acceptance.
  //
  // 0.05 comes from measurement, not preference: the geometric residual over 30 real
  // board clusters was median 0.0082, max 0.0276, while a cloud twice the model's size
  // scores above 0.05. Discrimination is left to flatness_rms_max, the extent gates and
  // isolation, which is where it already lived -- coverage was never separating board
  // from clutter here (board median 0.684 vs non-board 0.553).
  "square_geometric_residual_max": 0.05,
  "up_axis": [0.0, 0.0, 1.0],
  "stance_floor": 0.9,
  "isolation": false,
  "isolation_max_density": 0.3,
  "isolation_coplanar_tol": 0.03,
  "isolation_band_lo": 0.05,
  "isolation_band_hi": 0.30,
  "skip_ransac": true,
  "plane_ransac_max_iterations": 2000,
  "plane_ransac_inlier_threshold": 0.05,
  "voxel_downsample_enabled": false,
  "voxel_downsample_size": 0.015,
  "voxel_downsample_use_centroid": false,
  "voxel_parallel_threshold": 50000,
  "sensor_up_axis": "z",
  "initial_inplane_rotation_deg": 0.0,
  // Experimental solid-edge starting values. These fixture-derived values
  // await W7 real-bag tuning; they are not field-validated thresholds.
  "solid_edge_band_m": 0.03,
  "solid_minimum_edge_points": 8,
  "solid_minimum_points_per_covered_edge": 1,
  "solid_minimum_covered_edges": 3,
  "solid_longitudinal_bins_per_edge": 4,
  "solid_minimum_occupied_longitudinal_bins": 2,
  "max_icp_iterations": 100,
  "icp_pose_weight_threshold": 1e-4,
  "icp_good_fit_threshold": 0.035,
  "icp_outlier_threshold": 0.050,
  "icp_damping_factor": 1.0,
  "icp_min_inlier_points": 100,
}
