// Hollow 1000 mm target — Seyond / Innovusion Falcon detector tuning.
//
// This preserves the current Falcon operating values. Target geometry is
// selected only by target_config (hollow_1000_aruco_4_v1.json5); do not add
// plate, cutout, marker, or fixed-side geometry here.
{
  "detection_mode": "bbox_free",
  "foreground_method": "background_subtraction",
  "bbf_voxel": 0.05,
  "bg_dilation_radius": 1,
  "bg_warmup_frames": 20,
  "strip_plane_dist": 0.05,
  "strip_plane_min_frac": 0.08,
  "cluster_eps": 0.30,
  "cluster_min_points": 20,
  "vertical_gap_deg": 0.0,
  "merge_seed_min_points": 40,
  "merge_offset_tol": 0.02,
  "merge_dist_factor": 1.6,
  "patch_min_points": 60,
  "flatness_rms_max": 0.045,
  "patch_extent_lo_frac": 0.5,
  "patch_extent_hi_diag_frac": 1.8,
  "side_tol": 0.20,
  "cell_m": 0.02,
  "square_icp_residual_max": 0.85,
  "up_axis": [1.0, 0.0, 0.0],
  "stance_floor": 0.9,
  "isolation": false,
  "isolation_max_density": 0.3,
  "isolation_coplanar_tol": 0.03,
  "isolation_band_lo": 0.05,
  "isolation_band_hi": 0.30,
  "skip_ransac": true,
  "plane_ransac_max_iterations": 2000,
  "plane_ransac_inlier_threshold": 0.05,
  "voxel_downsample_enabled": true,
  "voxel_downsample_size": 0.015,
  "voxel_downsample_use_centroid": false,
  "voxel_parallel_threshold": 50000,
  "sensor_up_axis": "x",
  "initial_inplane_rotation_deg": 0.0,
  "max_icp_iterations": 50,
  "icp_pose_weight_threshold": 1e-4,
  "icp_good_fit_threshold": 0.05,
  "icp_outlier_threshold": 0.050,
  "icp_damping_factor": 0.5,
  "icp_min_inlier_points": 300,
  "icp_stable_pose_iterations": 3,

  // -- structural acceptance gates (perforated targets only) --
  // These decide whether a *terminated* hypothesis is trustworthy enough to
  // publish. Since the termination cleanup there is no post-ICP residual gate
  // in front of them, so they are the acceptance criteria; the values below
  // are the code defaults, stated explicitly so they are visible when tuning.
  "min_hypothesis_loss_separation_m": 1e-4, // Minimum avg_loss gap between the best and the
                                          // second-best *successful* quarter-turn hypothesis.
                                          // Guards against a wrong quarter-turn winning on a
                                          // near-tie. Only applied when two or more hypotheses
                                          // succeed; a lone success publishes unchecked.
  "min_cutout_rim_correspondences": 1,    // Minimum correspondences landing on a cutout rim.
                                          // Guards against a pose selected by the plate's square
                                          // outline alone, with no cutout evidence. A good frame
                                          // shows ~250, so the default of 1 is close to a no-op --
                                          // raise it to make cutout evidence genuinely required.
  "cutout_rim_tolerance_m": 0.03,         // Band width (m) around a cutout rim within which a
                                          // correspondence counts toward the gate above.
}
