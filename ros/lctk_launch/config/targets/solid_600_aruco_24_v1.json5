// 600 mm solid Calibration Target as physically built and recorded on 2026-08-12.
//
// Identical in geometry to solid_600_aruco_1_v1.json5; the printed marker is id 24, not
// id 1. Verified on 2026-08-31 by scanning every predefined OpenCV dictionary over 30
// frames of the newtype_1 recording (ZED, 960x600): the only marker present is id 24, in
// DICT_5X5_*, found in 25 of 30 frames. Against solid_600_aruco_1_v1 the locator reports
// "No ArUco markers detected" on every frame of this data.
//
// Shipped alongside rather than replacing solid_600_aruco_1_v1 because only the marker id
// has been confirmed against a physical board; the plate and paper dimensions below are
// inherited from that manifest and have NOT been measured. Confirm them before trusting a
// solve from this target -- a wrong paper_side scales every 3D corner and biases the
// extrinsic silently. See docs/issues/H-17-solid-600-preset-detects-nothing.md.
{
  schema_version: 1,
  target_id: "solid_600_aruco_24",
  revision: 1,
  board_frame_convention: "corner_aligned_plate_center_v1",

  plate: {
    side: "600mm",
    surface: { kind: "solid" },
  },

  fiducial: {
    kind: "square_aruco_grid",
    dictionary: "DICT_5X5_1000",
    marker_ids: [24],
    paper_side: "600mm",
    paper_center: {
      toward_left_corner: "0mm",
      toward_top_corner: "0mm",
    },
    outer_border: "60mm",
    cells_per_side: 1,
    marker_fill_ratio: 1.0,
    border_bits: 1,
  },

  lidar_orientation_reference: {
    kind: "mounting_up",
    local_axis: "+y",
  },
}
