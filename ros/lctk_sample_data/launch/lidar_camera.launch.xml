<?xml version="1.0"?>
<!--
    Launch file for publishing LiDAR and camera data for LiDAR-camera calibration.

    This launch file publishes both LiDAR and camera data from files
    with synchronized sensor data for LiDAR-camera calibration.

    Usage:
    ros2 launch lctk_sample_data lidar_camera.launch.xml
    ros2 launch lctk_sample_data lidar_camera.launch.xml pcap_file:=/path/to/file.pcap video_file:=/path/to/file.avi
-->
<launch>
    <!--
        Why the defaults point into lctk_launch rather than this package:
        the recordings used to live at lctk_sample_data/data/<N>, but a
        calibration session is now one self-contained directory, so each
        recording moved into the session that describes it. This package ships
        no data/ at all any more. The defaults below name the sample3 session's
        copy so that a bare `ros2 launch lctk_sample_data lidar_camera.launch.xml`
        still plays what it always played.

        These defaults only matter to direct invocation. `session_data.launch.py`
        always passes pcap_file and video_file explicitly, derived from the
        manifest -- one source of truth, which is the point of sessions.
    -->

    <!-- LiDAR Arguments -->
    <arg name="pcap_file"
         default="$(find-pkg-share lctk_launch)/sessions/sample3-hollow-velodyne/data/lidar.pcap"
         description="Path to the PCAP file containing Velodyne VLP-32C data"/>

    <arg name="pointcloud_topic"
         default="/sensing/lidar/top/pointcloud_raw"
         description="Output PointCloud2 topic name"/>

    <arg name="velodyne_packets_topic"
         default="/sensing/lidar/top/velodyne_packets"
         description="Output VelodyneScan packets topic name"/>

    <arg name="lidar_frame_id"
         default="velodyne_top"
         description="Frame ID for the point cloud messages"/>

    <arg name="rpm"
         default="600.0"
         description="Device rotation rate (RPM)"/>

    <arg name="port"
         default="2368"
         description="UDP port number for Velodyne data"/>

    <arg name="read_fast"
         default="false"
         description="Read PCAP file as fast as possible (true) or preserve timing (false)"/>

    <!-- Camera Arguments -->
    <arg name="video_file"
         default="$(find-pkg-share lctk_launch)/sessions/sample3-hollow-velodyne/data/video.avi"
         description="Path to the video file (mp4, avi, etc.)"/>

    <arg name="camera_name"
         default="front_center"
         description="Camera name"/>

    <arg name="camera_namespace"
         default="/sensing/camera/front_center"
         description="Camera namespace for topics"/>

    <arg name="camera_info_url"
         default="file://$(find-pkg-share lctk_launch)/sessions/sample3-hollow-velodyne/camera_info.yaml"
         description="Camera calibration URL (file:///path/to/calibration.yaml)"/>

    <arg name="camera_frame_id"
         default="camera_front_center"
         description="Frame ID for the image messages"/>

    <arg name="use_sensor_data_qos"
         default="false"
         description="Use sensor data QoS (BEST_EFFORT) for camera topics. Set true for realtime mode."/>

    <!-- Common Arguments -->

    <!-- Velodyne driver node -->
    <node pkg="velodyne_driver"
          exec="velodyne_driver_node"
          name="velodyne_driver_node"
          output="log">
        <!-- Parameters -->
        <param name="model" value="32C"/>
        <param name="rpm" value="$(var rpm)"/>
        <param name="frame_id" value="$(var lidar_frame_id)"/>
        <param name="port" value="2368"/>
        <param name="pcap" value="$(var pcap_file)"/>
        <param name="read_once" value="false"/>
        <param name="read_fast" value="false"/>
        <param name="repeat_delay" value="0.0"/>
        <param name="cut_angle" value="-0.01"/>
        <param name="timestamp_first_packet" value="false"/>
        <!-- Topic remapping -->
        <remap from="velodyne_packets" to="$(var velodyne_packets_topic)"/>
    </node>

    <!-- Velodyne pointcloud transform node -->
    <node pkg="velodyne_pointcloud"
          exec="velodyne_transform_node"
          name="velodyne_transform_node"
          output="log">
        <!-- Parameters -->
        <param name="model" value="32C"/>
        <param name="calibration" value="$(find-pkg-share velodyne_pointcloud)/params/VeloView-VLP-32C.yaml"/>
        <param name="min_range" value="0.9"/>
        <param name="max_range" value="130.0"/>
        <param name="view_direction" value="0.0"/>
        <param name="organize_cloud" value="false"/>

        <!-- Topic remapping -->
        <remap from="velodyne_points" to="$(var pointcloud_topic)"/>
        <remap from="velodyne_packets" to="$(var velodyne_packets_topic)"/>
    </node>

    <!-- GSCam node for video file playback -->
    <node pkg="gscam"
          exec="gscam_node"
          name="camera_driver"
          namespace="$(var camera_namespace)"
          output="log"
          launch-prefix="bash -c 'exec &quot;$@&quot; 2&gt;/dev/null' --">
        <!-- Parameters -->
        <!-- GStreamer pipeline configuration -->
        <!--
            Try different decoders based on availability:
            1. For MPEG4/AVI: filesrc ! avidemux ! mpeg4videoparse ! nvmpeg4videodec ! videoconvert (if NVIDIA available)
            2. Generic: filesrc ! decodebin ! videoconvert (requires working gstreamer1.0-libav)
            3. If libav fails with symbol errors, try reinstalling:
               sudo apt-get install -reinstall gstreamer1.0-libav libavutil56 libavfilter7
        -->
        <!-- Using decodebin for automatic format detection -->
        <param name="gscam_config" value="filesrc location=$(var video_file) ! avidemux name=demux demux.video_0 ! queue ! avdec_mpeg4 ! videoconvert ! video/x-raw,format=RGB"/>
        <param name="camera_name" value="camera"/>
        <param name="camera_info_url" value="$(var camera_info_url)"/>
        <param name="frame_id" value="$(var camera_frame_id)"/>
        <param name="sync_sink" value="true"/>
        <param name="reopen_on_eof" value="true"/>
        <param name="use_gst_timestamps" value="false"/>
        <param name="image_encoding" value="rgb8"/>
        <param name="use_sensor_data_qos" value="$(var use_sensor_data_qos)"/>
        <!-- Remap topics to remove extra 'camera' level -->
        <remap from="camera/image_raw" to="image_raw"/>
        <remap from="camera/camera_info" to="camera_info"/>
        <remap from="camera/image_raw/compressed" to="image_raw/compressed"/>
        <remap from="camera/image_raw/compressedDepth" to="image_raw/compressedDepth"/>
        <remap from="camera/image_raw/theora" to="image_raw/theora"/>
    </node>

    <!--
        Note: Sensor synchronization is now handled in the calibration pipeline.
        This launch file only publishes raw sensor data.
        The calibration launch file will handle synchronization internally.
    -->
</launch>
