<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>calibration_orchestrator</name>
  <version>0.1.0</version>
  <description>Configuration-driven multi-sensor calibration pipeline orchestrator</description>
  <maintainer email="lctk@ntu.edu.tw">NEWSLAB NTU</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>python3-yaml</depend>

  <!-- Calibration packages -->
  <exec_depend>lidar_board_detector</exec_depend>
  <exec_depend>aruco_locator_node</exec_depend>
  <exec_depend>advanced_extrinsic_solver</exec_depend>
  <exec_depend>lidar_to_lidar_solver</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
