<package format="3">
  <name>aruco_generator_node</name>
  <version>0.1.0</version>
  <description>ROS 2 node for generating ArUco marker patterns</description>
  <maintainer email="lctk@ntu.edu.tw">NEWSLAB NTU</maintainer>
  <license>MIT</license>

  <!-- ros/* and rust/* share one cargo workspace, so building this package
       resolves aruco_locator_node's lctk_interfaces dependency as well. The
       generated bindings must therefore exist before cargo runs here, even
       though no code in this package uses them. Without this, a clean tree
       fails with "no matching package named `lctk_interfaces` found". -->
  <build_depend>lctk_interfaces</build_depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>libopencv-dev</depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
