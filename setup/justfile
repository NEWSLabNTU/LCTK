# LCTK Development Environment Setup
#
# The preferred entry point is `./setup.sh` from the project root -- it gates on `just`
# itself and drives the selector. These recipes stay as the per-step interface.
#
# Usage: just -f setup/justfile <step>    - run one step (and its dependencies)
#        just -f setup/justfile setup     - run the default selection
#        just -f setup/justfile status    - verify every step against the machine
#        just -f setup/justfile verify    - same, non-zero exit if a required step fails
#        just -f setup/justfile clean-markers
#
# The step table -- ids, dependencies, install scripts, sizes and verifiers -- lives in
# `setup/steps.py`, not here. Recipes below are one-line delegations so the TUI, the
# marker engine and this file cannot drift from one another.

set shell := ["bash", "-uc"]
set positional-arguments

root_dir := justfile_directory()
steps := root_dir / "steps.py"

# Show available steps
default:
    @just --list

# Run the default selection (everything not marked optional)
setup:
    @python3 "{{steps}}" plan | while read -r step; do python3 "{{steps}}" run "$step" || exit 1; done
    @just verify

# Alias for setup; markers make it resume where it left off
resume: setup

# === Individual steps ===
# Each delegates to the engine, which resolves dependencies, checks the content-hashed
# marker, runs the script, and then verifies the software is actually present.

system-base:            ; @just _run system-base
build-tools:            ; @just _run build-tools
python:                 ; @just _run python
ros2:                   ; @just _run ros2
rosdep-init:            ; @just _run rosdep-init
ros-deps:               ; @just _run ros-deps
rust:                   ; @just _run rust
just-runner:            ; @just _run just
colcon-rust:            ; @just _run colcon-rust
python-guard:           ; @just _run python-guard
opencv:                 ; @just _run opencv
opencv-45-prefix:       ; @just _run opencv-45-prefix
gstreamer:              ; @just _run gstreamer
network-libs:           ; @just _run network-libs
geometric-libs:         ; @just _run geometric-libs
lint-tools:             ; @just _run lint-tools
cuda:                   ; @just _run cuda
dev-tools-debug:        ; @just _run dev-tools-debug
dev-tools-docs:         ; @just _run dev-tools-docs
submodules:             ; @just _run submodules

# === Utilities ===

# Show what is installed, checked against the machine rather than against markers
status:
    @python3 "{{steps}}" status

# Run every verifier; non-zero exit if a required step is missing
verify *args:
    @python3 "{{steps}}" verify "$@"

# Print the execution order for a selection (default: everything non-optional)
plan *args:
    @python3 "{{steps}}" plan "$@"

# Clear all markers, forcing every step to re-run
clean-markers:
    @python3 "{{steps}}" clean

# Clear one step's marker
clean-marker name:
    @python3 "{{steps}}" clean "$1"

# Run one step with its dependencies
_run name:
    #!/usr/bin/env bash
    set -eo pipefail
    python3 "{{steps}}" plan "{{name}}" | while read -r step; do
        python3 "{{steps}}" run "$step" || exit 1
    done
