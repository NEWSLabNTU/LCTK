<?xml version="1.0"?>
<!--
    Launch file for IoU overlapping evaluator.

    This launch file starts the IoU evaluator node that evaluates
    extrinsic matrix quality using IoU between board detection and
    LiDAR projection.

    Input topics:
    - Camera image topic
    - Point cloud topic

    Configuration:
    - Extrinsic matrix JSON file
-->
<launch>
    <!-- Launch Arguments -->
    <arg name="extrinsic_json"
         default="$(find-pkg-share iou_overlapping)/config/extrinsic.json"
         description="Path to extrinsic matrix JSON file"/>

    <arg name="camera_topic"
         default="/sensing/camera/front_center/image_raw"
         description="Input camera image topic"/>

    <arg name="pointcloud_topic"
         default="/sensing/lidar/top/pointcloud_raw"
         description="Input point cloud topic"/>

    <arg name="namespace"
         default="calibration"
         description="Namespace for the node"/>

    <arg name="use_best_effort_qos"
         default="true"
         description="Use best effort QoS for sensor input topics"/>

    <!-- IoU Evaluator Node -->
    <node pkg="iou_overlapping"
          exec="evaluator"
          name="iou_evaluator"
          namespace="$(var namespace)"
          output="screen">
        <param name="extrinsic_json" value="$(var extrinsic_json)"/>
        <param name="use_best_effort_qos" value="$(var use_best_effort_qos)"/>
        <!-- Simple topic remapping: base topics to actual sensor topics -->
        <remap from="image" to="$(var camera_topic)"/>
        <remap from="pointcloud" to="$(var pointcloud_topic)"/>
    </node>
</launch>