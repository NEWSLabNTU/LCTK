<?xml version="1.0"?>
<!--
    Launch file for calibration quality evaluator.

    This launch file starts the calibration evaluator node that measures
    extrinsic calibration quality using IoU metrics between detected
    board regions and projected LiDAR points.

    Input topics:
    - Camera image topic
    - Point cloud topic
    - ArUco detections topic (for ground truth board regions)
    - Extrinsic transform topic (live calibration) OR static JSON file

    Output topics:
    - IoU score (std_msgs/Float64)
    - Calibration metrics (lctk_interfaces/CalibrationMetrics)
    - Overlay visualization (sensor_msgs/Image)
    - Status (std_msgs/String)
-->
<launch>
    <!-- Launch Arguments -->
    <arg name="camera_topic"
         default="/sensing/camera/front_center/image_raw"
         description="Input camera image topic"/>

    <arg name="pointcloud_topic"
         default="/sensing/lidar/top/pointcloud_raw"
         description="Input point cloud topic"/>

    <arg name="aruco_detections_topic"
         default="/calibration/aruco_locator/aruco_detections"
         description="Input ArUco detections topic for ground truth board regions"/>

    <arg name="extrinsic_transform_topic"
         default="/calibration/extrinsic_solver/extrinsic_transform"
         description="Input extrinsic transform topic (live calibration)"/>

    <arg name="extrinsic_json"
         default=""
         description="Path to static extrinsic matrix JSON file (optional, fallback if live transform unavailable)"/>

    <arg name="namespace"
         default="calibration"
         description="Namespace for the node"/>

    <arg name="use_best_effort_qos"
         default="true"
         description="Use best effort QoS for sensor input topics"/>

    <arg name="sync_queue_size"
         default="10"
         description="Message synchronization queue size"/>

    <arg name="sync_slop"
         default="0.1"
         description="Message synchronization time tolerance in seconds"/>

    <arg name="log_level"
         default="info"
         description="ROS log level (debug, info, warn, error, fatal)"/>

    <!-- Calibration Evaluator Node -->
    <node pkg="calibration_evaluator"
          exec="calibration_evaluator_node"
          name="calibration_evaluator"
          namespace="$(var namespace)"
          output="screen"
          args="--ros-args --log-level $(var log_level)">
        <!-- Parameters -->
        <param name="extrinsic_json" value="$(var extrinsic_json)"/>
        <param name="use_best_effort_qos" value="$(var use_best_effort_qos)"/>
        <param name="sync_queue_size" value="$(var sync_queue_size)"/>
        <param name="sync_slop" value="$(var sync_slop)"/>

        <!-- Topic remapping -->
        <remap from="image" to="$(var camera_topic)"/>
        <remap from="pointcloud" to="$(var pointcloud_topic)"/>
        <remap from="aruco_detections" to="$(var aruco_detections_topic)"/>
        <remap from="extrinsic_transform" to="$(var extrinsic_transform_topic)"/>
    </node>
</launch>