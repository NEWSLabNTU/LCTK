<?xml version="1.0"?>
<!--
    Launch file for LiDAR-Camera calibration using modular components.

    This launch file combines the modular processing pipelines to perform
    complete LiDAR-Camera extrinsic calibration.

    Components:
    - Image processing (ArUco detection)
    - Point cloud processing (board detection)
    - Extrinsic calibration (direct solving without synchronization)
    - Visualization (optional)
-->
<launch>
    <!-- Common Arguments -->
    <arg name="aruco_config_file"
         default="$(find-pkg-share lctk_launch)/config/aruco/aruco_pattern.json5"
         description="Path to ArUco pattern configuration JSON5 file"/>

    <arg name="board_config_file"
         default="$(find-pkg-share lctk_launch)/config/board/board_detector.json5"
         description="Path to calibration board configuration JSON5 file"/>

    <arg name="camera_topic"
         default="/sensing/camera/front_center/image_raw"
         description="Input camera image topic"/>


    <arg name="pointcloud_topic"
         default="/sensing/lidar/top/pointcloud_raw"
         description="Input point cloud topic"/>

    <arg name="namespace"
         default="calibration"
         description="Namespace for all calibration nodes"/>

    <arg name="debug_mode"
         default="false"
         description="Enable debug logging and visualization. When enabled, publishes debug point clouds to debug/* topics"/>

    <arg name="enable_rviz"
         default="false"
         description="Launch RViz for calibration visualization"/>

    <arg name="use_best_effort_qos"
         default="true"
         description="Use best effort QoS for sensor input topics (true for live sensors, false for rosbag)"/>

    <arg name="max_distance"
         default="10.0"
         description="Maximum distance for point cloud filtering (meters)"/>

    <arg name="min_distance"
         default="1.0"
         description="Minimum distance for point cloud filtering (meters)"/>

    <!-- Image Processing Pipeline -->
    <include file="$(find-pkg-share lctk_launch)/launch/image_processing.launch.xml">
        <arg name="aruco_config_file" value="$(var aruco_config_file)"/>
        <arg name="camera_topic" value="$(var camera_topic)"/>
        <arg name="namespace" value="$(var namespace)"/>
        <arg name="debug_mode" value="$(var debug_mode)"/>
        <arg name="use_best_effort_qos" value="$(var use_best_effort_qos)"/>
    </include>

    <!-- ArUco Detection Visualization Overlay -->
    <!-- Removed: aruco_visualization.launch.xml - overlay functionality integrated into aruco_locator_node -->

    <!-- Point Cloud Processing Pipeline -->
    <include file="$(find-pkg-share lctk_launch)/launch/pointcloud_processing.launch.xml">
        <arg name="board_config_file" value="$(var board_config_file)"/>
        <arg name="aruco_config_file" value="$(var aruco_config_file)"/>
        <arg name="pointcloud_topic" value="$(var pointcloud_topic)"/>
        <arg name="board_detections_topic" value="/calibration/calibration_board_locator/board_detections"/>
        <arg name="namespace" value="$(var namespace)"/>
        <arg name="debug_mode" value="$(var debug_mode)"/>
        <arg name="use_best_effort_qos" value="$(var use_best_effort_qos)"/>
    </include>

    <!-- Extrinsic Calibration -->
    <include file="$(find-pkg-share lctk_launch)/launch/extrinsic_calibration.launch.xml">
        <arg name="board_detections_topic" value="/calibration/calibration_board_locator/calibration_board_detections"/>
        <arg name="namespace" value="$(var namespace)"/>
        <arg name="debug_mode" value="$(var debug_mode)"/>
    </include>

    <!-- Pointcloud Image Overlay Visualization (Python) -->
    <node pkg="pointcloud_image_overlay"
          exec="overlay_node"
          name="pointcloud_image_overlay"
          namespace="$(var namespace)"
          output="screen">
        <param name="extrinsic_json5" value="$(find-pkg-share lctk_launch)/config/extrinsic.json5"/>
        <param name="use_best_effort_qos" value="$(var use_best_effort_qos)"/>
        <!-- Simple topic remapping: base topics to actual camera/lidar topics -->
        <remap from="image" to="$(var camera_topic)"/>
        <remap from="pointcloud" to="$(var pointcloud_topic)"/>
    </node>

    <!-- RViz Visualization (Optional) -->
    <include file="$(find-pkg-share lctk_launch)/launch/rviz.launch.xml" if="$(var enable_rviz)"/>
</launch>
