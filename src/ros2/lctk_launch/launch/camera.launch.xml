<?xml version="1.0"?>
<!--
    Launch file for publishing Image topic from a video file using GStreamer.

    This launch file uses the gscam package which provides a ROS 2 camera driver
    for GStreamer-based video streams, including video files.

    Requirements:
    - ros-humble-gscam (install with: sudo apt install ros-humble-gscam)
    - GStreamer plugins for video decoding

    Usage:
    ros2 launch lctk_launch camera.launch.xml video_file:=/path/to/video.avi
-->
<launch>
    <!-- Launch Arguments -->
    <arg name="video_file"
         description="Path to the video file (mp4, avi, etc.)"/>

    <arg name="camera_name"
         default="front_center"
         description="Camera name"/>

    <arg name="camera_namespace"
         default="/sensing/camera/front_center"
         description="Camera namespace for topics"/>

    <arg name="camera_info_url"
         default="file://$(find-pkg-share lctk_launch)/config/camera/front_center_camera_info.yaml"
         description="Camera calibration URL (file:///path/to/calibration.yaml)"/>

    <arg name="frame_id"
         default="camera_frame"
         description="Frame ID for the image messages"/>

    <arg name="loop"
         default="True"
         description="Loop video playback"/>

    <!-- GSCam node for video file playback -->
    <node pkg="gscam"
          exec="gscam_node"
          name="camera_driver"
          namespace="$(var camera_namespace)"
          output="log"
          launch-prefix="bash -c 'exec &quot;$@&quot; 2&gt;/dev/null' --">
        <!-- Parameters -->
        <!-- GStreamer pipeline configuration -->
        <!--
            Try different decoders based on availability:
            1. For MPEG4/AVI: filesrc ! avidemux ! mpeg4videoparse ! nvmpeg4videodec ! videoconvert (if NVIDIA available)
            2. Generic: filesrc ! decodebin ! videoconvert (requires working gstreamer1.0-libav)
            3. If libav fails with symbol errors, try reinstalling:
               sudo apt-get install -reinstall gstreamer1.0-libav libavutil56 libavfilter7
        -->
        <!-- Using decodebin for automatic format detection -->
        <param name="gscam_config" value="filesrc location=$(var video_file) ! avidemux name=demux demux.video_0 ! queue ! avdec_mpeg4 ! videoconvert ! video/x-raw,format=RGB"/>
        <param name="camera_name" value="camera"/>
        <param name="camera_info_url" value="$(var camera_info_url)"/>
        <param name="frame_id" value="$(var frame_id)"/>
        <param name="sync_sink" value="false"/>
        <param name="reopen_on_eof" value="$(var loop)"/>
        <param name="use_gst_timestamps" value="false"/>
        <param name="image_encoding" value="rgb8"/>
        <!-- Remap topics to remove extra 'camera' level -->
        <remap from="camera/image_raw" to="image_raw"/>
        <remap from="camera/camera_info" to="camera_info"/>
        <remap from="camera/image_raw/compressed" to="image_raw/compressed"/>
        <remap from="camera/image_raw/compressedDepth" to="image_raw/compressedDepth"/>
        <remap from="camera/image_raw/theora" to="image_raw/theora"/>
    </node>
</launch>
