{
    // ========================================
    // RANSAC Plane Fitting Parameters
    // ========================================
    // max number of RANSAC steps
    "plane_ransac_max_iterations": 500,
    // the loss threshold that a point is considered an inlier
    "plane_ransac_inlier_threshold": 0.5,

    // ========================================
    // ICP Algorithm Parameters
    // ========================================
    // max number of ICP iterations (increased for observing convergence behavior)
    "max_icp_iterations": 3000,
    // pose weight is amount of pose change per iteration
    // the ICP terminates if pose weight is below this threshold several times
    "icp_pose_weight_threshold": 1e-5,  // Tightened for better convergence
    // the maximum accepted ICP loss (balanced for stability)
    "icp_rejection_threshold": 0.03,
    // good fit threshold for convergence detection (tightened for accuracy)
    "icp_good_fit_threshold": 0.01,  // Tightened from 0.03 to 0.01
    // outlier rejection threshold for correspondence filtering (tightened)
    "icp_outlier_threshold": 0.08,  // Tightened from 0.12 to 0.08
    // adaptive threshold multiplier for outlier rejection
    "icp_adaptive_threshold_multiplier": 1.2,
    // minimum adaptive threshold value
    "icp_adaptive_threshold_min": 0.01,  // Tightened from 0.015 to 0.01
    // maximum adaptive threshold value
    "icp_adaptive_threshold_max": 0.15,  // Tightened from 0.3 to 0.15
    // damping factor for pose updates (increased for better convergence)
    "icp_damping_factor": 0.6,  // Increased from 0.35 to 0.6
    // minimum number of inlier points required to continue ICP iterations
    "icp_min_inlier_points": 130,

    // ========================================
    // Board Geometry Parameters
    // ========================================
    // the length of border margin
    "board_width": "1000mm",    // mm
    // the radius of circle holes
    "hole_radius": "150mm",     // mm
    // suppose the center of board is (0, 0)
    // the center of hole will be at (+/- shift, +/- shift)
    "hole_center_shift": "200mm", // mm
}
