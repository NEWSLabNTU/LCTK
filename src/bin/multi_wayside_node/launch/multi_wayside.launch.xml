<?xml version="1.0"?>
<!--
    Launch file for multi_wayside_node with comprehensive parameter configuration.
    
    This launch file sets up the multi-wayside LiDAR-to-LiDAR calibration node
    with comprehensive parameter configuration and optional RViz2 for visualization.
-->
<launch>
    <!-- Launch Arguments -->
    <arg name="config_file" 
         default="$(find-pkg-share multi_wayside_node)/config/multi_wayside.yaml"
         description="Path to the ROS 2 parameter file for multi_wayside_node"/>
    
    <arg name="rviz_config" 
         default="$(find-pkg-share multi_wayside_node)/config/multi_wayside.rviz"
         description="Path to the RViz2 configuration file"/>
    
    <arg name="use_rviz" 
         default="true"
         description="Whether to start RViz2 for visualization"/>
    
    <arg name="lidar1_topic" 
         default="/lidar1/points"
         description="Topic name for LiDAR 1 point cloud input"/>
    
    <arg name="lidar2_topic" 
         default="/lidar2/points"
         description="Topic name for LiDAR 2 point cloud input"/>
    
    <arg name="log_level" 
         default="info"
         description="Log level for the multi_wayside_node"/>
    
    <arg name="namespace" 
         default=""
         description="Namespace for the node (optional)"/>
    
    <!-- Multi-wayside Node -->
    <node pkg="multi_wayside_node" 
          exec="multi_wayside_node" 
          name="multi_wayside_node"
          namespace="$(var namespace)"
          output="screen">
        
        <!-- Load parameters from YAML file -->
        <param from="$(var config_file)"/>
        
        <!-- Topic remappings -->
        <remap from="/lidar1/points" to="$(var lidar1_topic)"/>
        <remap from="/lidar2/points" to="$(var lidar2_topic)"/>
        
        <!-- ROS arguments including log level -->
        <ros>
            <arg value="--log-level"/>
            <arg value="$(var log_level)"/>
        </ros>
    </node>
    
    <!-- RViz2 Node (conditional) -->
    <group if="$(var use_rviz)">
        <node pkg="rviz2" 
              exec="rviz2" 
              name="rviz2"
              args="-d $(var rviz_config)"
              output="screen">
            <!-- Optional: Set RViz2 to use the same namespace -->
            <param name="use_sim_time" value="false"/>
        </node>
    </group>
    
    <!-- Optional: Static transform publishers for testing -->
    <!-- Uncomment and modify these if you need static transforms between frames -->
    <!--
    <node pkg="tf2_ros" 
          exec="static_transform_publisher" 
          name="lidar1_to_base_link"
          args="0 0 0 0 0 0 base_link lidar1"/>
    
    <node pkg="tf2_ros" 
          exec="static_transform_publisher" 
          name="lidar2_to_base_link"
          args="2 0 0 0 0 0 base_link lidar2"/>
    -->
</launch>