    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic: /calibration_markers
      Name: MarkerArray_Calibration
      Namespaces:
        board_frame_lidar1: true
        board_frame_lidar2: true
        board_outline_lidar1: true
        board_outline_lidar2: true
        board_text_lidar1: true
        board_text_lidar2: true
