<?xml version="1.0"?>
<!--
    Launch file for calibration visualization.
    
    This launch file starts the pointcloud image overlay node that visualizes
    the calibration results by projecting point clouds onto camera images.
    
    Input topics:
    - Synchronized point cloud and image
    - Camera info
    - Extrinsic transform
    
    Output topics:
    - Visualization markers and overlays
-->
<launch>
    <!-- Launch Arguments -->
    <arg name="pointcloud_topic"
         default="/calibration/synchronizer/synchronized_pointcloud"
         description="Input synchronized point cloud topic"/>
    
    <arg name="image_topic"
         default="/calibration/synchronizer/synchronized_image"
         description="Input synchronized image topic"/>
    
    <arg name="camera_info_topic"
         default="/sensing/camera/front_center/camera_info"
         description="Input camera info topic"/>
    
    <arg name="extrinsic_transform_topic"
         default="/calibration/extrinsic_solver/extrinsic_transform"
         description="Input extrinsic transform topic"/>
    
    <arg name="namespace"
         default="calibration"
         description="Namespace for the nodes"/>
    
    <arg name="max_distance"
         default="10.0"
         description="Maximum distance for point cloud filtering (meters)"/>
    
    <arg name="min_distance"
         default="1.0"
         description="Minimum distance for point cloud filtering (meters)"/>
    
    <!-- Pointcloud Image Overlay Node (with Rerun visualization) -->
    <node pkg="pointcloud_image_overlay"
          exec="pointcloud_image_overlay"
          name="pointcloud_image_overlay"
          namespace="$(var namespace)"
          output="screen">
        <param name="max_distance" value="$(var max_distance)"/>
        <param name="min_distance" value="$(var min_distance)"/>
        <param name="camera_depth_thresh" value="0.0"/>
        <param name="keep_back_points" value="false"/>
        <param name="message_timeout_seconds" value="5"/>
        <remap from="input_pointcloud" to="$(var pointcloud_topic)"/>
        <remap from="input_image" to="$(var image_topic)"/>
        <remap from="camera_info" to="$(var camera_info_topic)"/>
        <remap from="extrinsic_transform" to="$(var extrinsic_transform_topic)"/>
    </node>
</launch>