<?xml version="1.0"?>
<!--
    Launch file for image processing pipeline (ArUco marker detection).

    This launch file starts the ArUco locator node that detects ArUco markers
    in camera images and publishes their locations.

    Input topics:
    - Camera image topic
    - Camera info topic

    Output topics:
    - ArUco detections
-->
<launch>
    <!-- Launch Arguments -->
    <arg name="aruco_config_file"
         default=""
         description="Path to ArUco pattern configuration JSON5 file"/>

    <arg name="camera_topic"
         default="/sensing/camera/front_center/image_raw"
         description="Input camera image topic"/>

    <arg name="camera_info_topic"
         default="/sensing/camera/front_center/camera_info"
         description="Input camera info topic"/>

    <arg name="aruco_detections_topic"
         default="/calibration/aruco_locator/aruco_detections"
         description="Output ArUco detections topic"/>

    <arg name="namespace"
         default="calibration"
         description="Namespace for the nodes"/>

    <arg name="debug_mode"
         default="false"
         description="Enable debug logging and visualization"/>

    <!-- ArUco Locator Node -->
    <node pkg="aruco_locator_node"
          exec="aruco_locator_node"
          name="aruco_locator"
          namespace="$(var namespace)/aruco_locator"
          output="screen">
        <param name="aruco_config_file" value="$(var aruco_config_file)"/>
        <param name="debug_mode" value="$(var debug_mode)"/>
        <param name="debug_overlay_enabled" value="$(var debug_mode)"/>
        <param name="camera_namespace" value="/sensing/camera/front_center"/>
        <remap from="aruco_detections" to="$(var aruco_detections_topic)"/>
    </node>
</launch>