<?xml version="1.0"?>
<!--
    Launch file for ArUco detection visualization.

    This launch file includes the ArUco detection overlay node that draws
    bounding boxes on camera images for visualization in RViz.

    Usage:
    ros2 launch calib_launch aruco_visualization.launch.xml
-->
<launch>
    <!-- Launch Arguments -->
    <arg name="image_topic"
         default="/sensing/camera/front_center/image_raw"
         description="Input camera image topic"/>

    <arg name="detection_topic"
         default="/calibration/aruco_locator/aruco_detections"
         description="Input ArUco detections topic"/>

    <arg name="output_topic"
         default="/calibration/visualization/image_with_detections"
         description="Output annotated image topic"/>

    <arg name="sync_tolerance"
         default="0.1"
         description="Time synchronization tolerance in seconds"/>

    <!-- Detection Overlay Node -->
    <node pkg="aruco_detection_overlay"
          exec="aruco_detection_overlay"
          name="aruco_detection_overlay"
          namespace="calibration/visualization"
          output="log">
        <param name="image_topic" value="$(var image_topic)"/>
        <param name="detection_topic" value="$(var detection_topic)"/>
        <param name="output_topic" value="$(var output_topic)"/>
    </node>
</launch>