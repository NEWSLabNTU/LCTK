<?xml version="1.0"?>
<!--
    Launch file for publishing Image topic from a video file using GStreamer.
    
    This launch file uses the gscam package which provides a ROS 2 camera driver 
    for GStreamer-based video streams, including video files.
    
    Requirements:
    - ros-humble-gscam (install with: sudo apt install ros-humble-gscam)
    - GStreamer plugins for video decoding
    
    Usage:
    ros2 launch calib_launch camera.launch.xml video_file:=/path/to/video.avi
-->
<launch>
    <!-- Launch Arguments -->
    <arg name="video_file" 
         description="Path to the video file (mp4, avi, etc.)"/>
    
    <arg name="camera_name"
         default="camera"
         description="Camera name for topic namespace"/>
    
    <arg name="camera_info_url" 
         default=""
         description="Camera calibration URL (file:///path/to/calibration.yaml)"/>
    
    <arg name="frame_id" 
         default="camera_frame"
         description="Frame ID for the image messages"/>
    
    <arg name="loop" 
         default="false"
         description="Loop video playback"/>
    
    <!-- GSCam node for video file playback -->
    <node pkg="gscam" 
          exec="gscam_node" 
          name="$(var camera_name)_gscam"
          namespace="$(var camera_name)"
          output="screen">
        <!-- Parameters -->
        <!-- GStreamer pipeline: Based on official gscam videofile example -->
        <param name="gscam_config" value="filesrc location=$(var video_file) ! decodebin ! videoconvert"/>
        <param name="camera_name" value="$(var camera_name)"/>
        <param name="camera_info_url" value="$(var camera_info_url)"/>
        <param name="frame_id" value="$(var frame_id)"/>
        <param name="sync_sink" value="false"/>
        <param name="reopen_on_eof" value="$(var loop)"/>
    </node>
</launch>