#!/bin/bash
# Automatically source ROS setup based on Ubuntu version

# Detect Ubuntu version
if [ -f /etc/os-release ]; then
    . /etc/os-release
    UBUNTU_VERSION=$VERSION_ID
else
    echo "Warning: Cannot detect Ubuntu version, defaulting to Humble"
    UBUNTU_VERSION="22.04"
fi

# Map Ubuntu version to ROS distro
case "$UBUNTU_VERSION" in
    "22.04")
        ROS_DISTRO="humble"
        ;;
    "24.04")
        ROS_DISTRO="jazzy"
        ;;
    *)
        echo "Warning: Unknown Ubuntu version $UBUNTU_VERSION, defaulting to Humble"
        ROS_DISTRO="humble"
        ;;
esac

# Source ROS setup if it exists
ROS_SETUP="/opt/ros/$ROS_DISTRO/setup.bash"
if [ -f "$ROS_SETUP" ]; then
    source "$ROS_SETUP"
    echo "Sourced ROS $ROS_DISTRO (Ubuntu $UBUNTU_VERSION)"
else
    echo "Warning: ROS $ROS_DISTRO setup not found at $ROS_SETUP"
fi

# Source workspace overlay if it exists
WORKSPACE_SETUP="$PWD/install/setup.bash"
if [ -f "$WORKSPACE_SETUP" ]; then
    watch_file "$WORKSPACE_SETUP"
    source "$WORKSPACE_SETUP"
    echo "Sourced workspace overlay"
fi

# Check empy version (ROS 2 Humble requires empy < 4)
if command -v python3 &> /dev/null; then
    EMPY_VERSION=$(python3 -c "import empy; print(empy.__version__)" 2>/dev/null)
    if [ $? -eq 0 ]; then
        EMPY_MAJOR=$(echo "$EMPY_VERSION" | cut -d. -f1)
        if [ "$EMPY_MAJOR" -ge 4 ]; then
            echo "WARNING: empy version $EMPY_VERSION detected (>= 4.x)"
            echo "  ROS 2 Humble requires empy < 4 (preferably 3.3.4)"
            echo "  This may cause build failures with errors like:"
            echo "    AttributeError: module 'string' has no attribute 'split'"
            echo "  To fix: pip3 uninstall empy && sudo apt-get install python3-empy"
        fi
    fi
fi

export OPENCV_PKGCONFIG_NAME=opencv4
