#!/bin/bash
# Automatically source ROS setup based on Ubuntu version

# Detect Ubuntu version
if [ -f /etc/os-release ]; then
    . /etc/os-release
    UBUNTU_VERSION=$VERSION_ID
else
    echo "Warning: Cannot detect Ubuntu version, defaulting to Humble"
    UBUNTU_VERSION="22.04"
fi

# Map Ubuntu version to ROS distro
case "$UBUNTU_VERSION" in
    "22.04")
        ROS_DISTRO="humble"
        ;;
    "24.04")
        ROS_DISTRO="jazzy"
        ;;
    *)
        echo "Warning: Unknown Ubuntu version $UBUNTU_VERSION, defaulting to Humble"
        ROS_DISTRO="humble"
        ;;
esac

# Source ROS setup if it exists
ROS_SETUP="/opt/ros/$ROS_DISTRO/setup.bash"
if [ -f "$ROS_SETUP" ]; then
    source "$ROS_SETUP"
    echo "Sourced ROS $ROS_DISTRO (Ubuntu $UBUNTU_VERSION)"
else
    echo "Warning: ROS $ROS_DISTRO setup not found at $ROS_SETUP"
fi

# Source workspace overlay if it exists
WORKSPACE_SETUP="$PWD/install/setup.bash"
if [ -f "$WORKSPACE_SETUP" ]; then
    watch_file "$WORKSPACE_SETUP"
    source "$WORKSPACE_SETUP"
    echo "Sourced workspace overlay"
fi

# Check empy version (ROS 2 Humble requires empy < 4)
if command -v python3 &> /dev/null; then
    EMPY_VERSION=$(python3 -c "import empy; print(empy.__version__)" 2>/dev/null)
    if [ $? -eq 0 ]; then
        EMPY_MAJOR=$(echo "$EMPY_VERSION" | cut -d. -f1)
        if [ "$EMPY_MAJOR" -ge 4 ]; then
            echo "WARNING: empy version $EMPY_VERSION detected (>= 4.x)"
            echo "  ROS 2 Humble requires empy < 4 (preferably 3.3.4)"
            echo "  This may cause build failures with errors like:"
            echo "    AttributeError: module 'string' has no attribute 'split'"
            echo "  To fix: pip3 uninstall empy && sudo apt-get install python3-empy"
        fi
    fi
fi

export OPENCV_PKGCONFIG_NAME=opencv4

# --- OpenCV selection -------------------------------------------------------
# This repo needs OpenCV <= 4.6: the aruco module was folded into objdetect in
# 4.7 and `estimate_pose_single_markers` removed, so `opencv::aruco` (used by
# aruco-config, aruco-detector, aruco-generator) does not exist on 4.7+.
# ROS Humble agrees - /opt/ros/humble/lib/libcv_bridge.so links libopencv_*.so.4.5d.
#
# On the Jetson two OpenCVs are installed and neither is directly usable:
#   * NVIDIA libopencv-dev 4.8.0 -> headers /usr/include/opencv4, libs /usr/lib.
#     Too new (no aruco module), and its /usr/lib/pkgconfig/opencv4.pc claims
#     prefix=/usr/local where nothing OpenCV lives, so the opencv crate's
#     pkg_config probe panics with
#       "Discovered OpenCV include paths is empty or contains non-existent paths"
#   * Ubuntu libopencv-*4.5d 4.5.4 -> runtime .so only (contrib incl. aruco), in
#     /usr/lib/aarch64-linux-gnu. No headers: its -dev packages own the same
#     /usr/include/opencv4 paths as NVIDIA's, so apt cannot install both.
#
# Resolution: keep NVIDIA 4.8.0 installed for CUDA work, and side-install the
# 4.5.4 *headers* into a private prefix that only this repo points at. The
# prefix's lib/ holds only symlinks back to the already-installed 4.5.4
# runtime, so nothing is duplicated and nothing is registered with dpkg.
# SONAMEs differ (.so.408 vs .so.4.5d), so the two never collide at run time.
# Rebuild the prefix with: setup/scripts/install-opencv-4.5-prefix.sh
#
# The opencv crate probes `environment` before `pkg_config`, so the three vars
# below win over any .pc. All three are required together - the environment
# probe is all-or-nothing.
OPENCV_PREFIX="${LCTK_OPENCV_PREFIX:-$HOME/opt/opencv-4.5.4}"
if [ -d "$OPENCV_PREFIX/include/opencv4" ] && [ -e "$OPENCV_PREFIX/lib/libopencv_core.so" ]; then
    export OPENCV_INCLUDE_PATHS="$OPENCV_PREFIX/include/opencv4"
    export OPENCV_LINK_PATHS="$OPENCV_PREFIX/lib"
    export OPENCV_LINK_LIBS=opencv_core,opencv_imgproc,opencv_imgcodecs,opencv_calib3d,opencv_features2d,opencv_flann,opencv_highgui,opencv_objdetect,opencv_videoio,opencv_dnn,opencv_aruco
    echo "OpenCV: pinned to 4.5.4 prefix $OPENCV_PREFIX"
elif [ -d /usr/include/opencv4 ]; then
    # No private prefix (non-Jetson host): trust pkg-config when it resolves to
    # a real include dir, which it does wherever a sane libopencv-dev is installed.
    OPENCV_PC_INC=$(pkg-config --variable=includedir opencv4 2>/dev/null || true)
    if [ -n "$OPENCV_PC_INC" ] && [ -d "$OPENCV_PC_INC" ]; then
        : # leave the crate's pkg_config probe alone
    else
        echo "Warning: no OpenCV 4.5.4 prefix at $OPENCV_PREFIX and pkg-config opencv4 is broken"
        echo "  run setup/scripts/install-opencv-4.5-prefix.sh"
    fi
    unset OPENCV_PC_INC
else
    echo "Warning: OpenCV dev headers not found - run setup/scripts/install-opencv-4.5-prefix.sh"
fi
unset OPENCV_PREFIX
